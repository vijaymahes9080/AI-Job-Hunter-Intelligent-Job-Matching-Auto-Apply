# AI Job Hunter — Environment Variables Example

# Adzuna API Keys (Free tier: https://developer.adzuna.com)
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# RapidAPI Key (For LinkedIn / Naukri scrapers)
RAPIDAPI_KEY=your_rapidapi_key

# Reed UK API Key (Free tier: https://www.reed.co.uk/developers/jobseeker)
REED_API_KEY=your_reed_api_key

# LinkedIn OAuth 2.0 PKCE Credentials
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# GitHub OAuth 2.0 Credentials (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Optional Frontend Prefixes
VITE_ADZUNA_APP_ID=your_adzuna_app_id
VITE_ADZUNA_APP_KEY=your_adzuna_app_key
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id
