# ---------------------------------------------------------------------------
# AI Job Hunter API
# Copy this file to .env for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173

# PostgreSQL (required for durable production data).
# DATABASE_URL=postgresql://jobhunter:change-me@localhost:5432/jobhunter
DATABASE_SSL=false

# Demo mode: only applied when DATABASE_URL is empty.
# Records are real while the process runs but are lost on restart.
ALLOW_DEMO_DB=true
SEED_DEMO=true

# Authentication (required in production)
JWT_SECRET=replace-with-at-least-32-random-characters
# Demo account seeded in demo mode
DEMO_EMAIL=demo@aijobhunter.local
DEMO_PASSWORD=Demo@12345

# Public job discovery (all open, no paid keys)
REMOTIVE_QUERIES=software,react,python,data,security,devops,machine learning
GREENHOUSE_BOARDS=gitlab,elastic,mongodb,datadog,databricks,groww,vercel,figma,discord,stripe
LEVER_COMPANIES=cred

# Optional: GitHub REST token raises rate limits for public portfolio analysis
# GITHUB_TOKEN=

# Optional: OpenAI-compatible, self-hosted/open-weight endpoint
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=

# Automation
ENABLE_SCHEDULER=false
DISCOVERY_INTERVAL_MINUTES=360
CRON_SECRET=
# NOTIFICATION_WEBHOOK_URL=

# Security / uploads
BCRYPT_ROUNDS=10
MAX_UPLOAD_BYTES=5242880
TRUST_PROXY=false

# Frontend override (defaults to same-origin /api/v1)
# VITE_API_BASE_URL=
